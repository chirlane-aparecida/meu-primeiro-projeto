
programa { 
  funcao inicio(){
    inteiro opcao 
    opcao = 0 
    enquanto (opcao !=3)
    {
escreva ("\n===== MENU =====\n")
escreva ("1 - Ver Saldo\n")
escreva ("2 - Fazer depósito\n")
escreva ("3 - Sair\n")
escreva ("Escolha uma opção: ")
leia (opcao)

se (opcao == 1)
{
  escreva ("Ver saldo\n")
  }
  se (opcao == 2)
  {
    escreva ("Fazer depósito\n")
  }
  se (opcao ==3)
  { 
    escreva ("Programa encerrado\n")
  }

    }
  }
}
